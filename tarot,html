});

// Track mouse for following eyes
document.addEventListener('mousemove', (e) => {
  const eyes = document.getElementById('following-eyes');
  if (!eyes) return;
  const eyeEls = eyes.querySelectorAll('.eye');
  eyeEls.forEach(eye => {
    const rect = eye.getBoundingClientRect();
    const eyeCenterX = rect.left + rect.width / 2;
    const eyeCenterY = rect.top + rect.height / 2;
    const angle = Math.atan2(e.clientY - eyeCenterY, e.clientX - eyeCenterX);
    const pupil = eye.querySelector(':after') || eye;
    const distance = 3;
    const pupilX = distance * Math.cos(angle);
    const pupilY = distance * Math.sin(angle);
    eye.style.setProperty('--pupil-x', `${pupilX}px`);
    eye.style.setProperty('--pupil-y', `${pupilY}px`);
  });
});

// Data SDK
window.dataSdk.init({
  onDataChanged(data) {
    allReadings = data;
    if (document.getElementById('page-history').style.display !== 'none') renderHistory();
  }
});

