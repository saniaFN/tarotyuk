// ===== STATE =====
let currentCategory = '';
let currentCard = null;
let allReadings = [];
let deletingId = null;

// ===== DAILY CARD (seeded by date) =====
function getDailyCard() {
  const d = new Date();
  const seed = d.getFullYear() * 10000 + (d.getMonth()+1) * 100 + d.getDate();
  return TAROT_DECK[seed % TAROT_DECK.length];
}

function initDailyCard() {
  const c = getDailyCard();
  document.getElementById('daily-card-emoji').textContent = c.emoji;
  document.getElementById('daily-card-name').textContent = c.name;
  document.getElementById('daily-card-meaning').textContent = c.meaning;
}

// ===== CATEGORIES =====
function renderCategories() {
  const grid = document.getElementById('categories-grid');
  grid.innerHTML = '';
  CATEGORIES.forEach((cat, i) => {
    const div = document.createElement('div');
    div.className = 'category-card rounded-xl p-4 text-center animate-fadeUp';
    div.style.cssText = `background:rgba(42,26,78,0.5);animation-delay:${0.1*i}s;cursor:pointer`;
    div.innerHTML = `<div style="font-size:1.8rem" class="mb-1">${cat.icon}</div><p class="text-xs font-medium" style="color:#ba9cff">${cat.label}</p><p class="text-xs mt-1" style="color:rgba(186,156,255,0.4)">${cat.desc}</p>`;
    div.addEventListener('click', () => openCategory(cat.id));
    grid.appendChild(div);
  });
}

function openCategory(id) {
  if (id === 'yesno') { showPage('yesno'); return; }
  if (id === 'dream') { showPage('dream'); return; }
  if (id === 'liminal') { showPage('liminal'); initLiminal(); return; }
  currentCategory = id;
  const cat = CATEGORIES.find(c => c.id === id);
  document.getElementById('reading-title').textContent = cat.icon + ' ' + cat.label;
  document.getElementById('reading-result').style.display = 'none';
  renderCardSpread();
  showPage('reading');
}

// ===== CARD SPREAD =====
function renderCardSpread() {
  const spread = document.getElementById('card-spread');
  spread.innerHTML = '';
  const shuffled = [...TAROT_DECK].sort(() => Math.random() - 0.5).slice(0, 7);
  shuffled.forEach((card, i) => {
    const div = document.createElement('div');
    div.className = 'tarot-pick-card card-back rounded-xl relative';
    div.style.cssText = `cursor:pointer;animation:fadeUp 0.4s ease ${i*0.08}s both`;
    div.innerHTML = `<span style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:1.5rem;color:rgba(186,156,255,0.4)">✦</span>`;
    div.addEventListener('click', () => pickCard(card, div));
    spread.appendChild(div);
  });
}

function pickCard(card, el) {
  currentCard = card;
  // Animate chosen card
  el.classList.add('animate-cardReveal');
  el.classList.remove('card-back');
  el.style.background = 'linear-gradient(135deg, rgba(186,156,255,0.3), rgba(255,156,219,0.2))';
  el.style.border = '2px solid rgba(186,156,255,0.6)';
  el.innerHTML = `<span style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:2rem">${card.emoji}</span>`;

  // Disable other cards
  document.querySelectorAll('#card-spread .tarot-pick-card').forEach(c => {
    if (c !== el) { c.style.opacity = '0.3'; c.style.pointerEvents = 'none'; }
  });

  // Show result
  setTimeout(() => showResult(card), 600);
}

function showResult(card) {
  const isReversed = Math.random() > 0.65;
  const catKey = currentCategory || 'general';
  const meaningFn = CATEGORY_MEANINGS[catKey] || CATEGORY_MEANINGS.general;

  // Show loading state
  document.getElementById('result-loading').style.display = '';
  document.getElementById('result-content').style.display = 'none';
  document.getElementById('reading-result').style.display = 'block';
  document.getElementById('reading-result').scrollIntoView({ behavior: 'smooth' });

  // Simulate reading with loading messages
  const msgs = [
    'Membaca energimu...',
    'Menanyakan pada bintang...',
    'Mendengarkan bisikan semesta...',
    'Mencari jawaban di bawah tempat tidur...'
  ];
  const randomMsg = msgs[Math.floor(Math.random() * msgs.length)];
  document.querySelector('.loading-msg').textContent = randomMsg;

  setTimeout(() => {
    document.getElementById('result-loading').style.display = 'none';
    document.getElementById('result-content').style.display = '';
    
    document.getElementById('result-emoji').textContent = card.emoji;
    document.getElementById('result-name').textContent = card.name + (isReversed ? ' (Terbalik)' : '');
    document.getElementById('result-position').textContent = isReversed ? '↕ Posisi Terbalik — Refleksi lebih dalam diperlukan' : '↑ Posisi Tegak — Energi mengalir positif';
    document.getElementById('result-meaning').textContent = meaningFn(card);
    document.getElementById('result-crystal').textContent = card.crystal + ' — letakkan dekatmu untuk memperkuat energi ini 💎';
    document.getElementById('journal-input').value = '';
  }, 1200);
}

function resetReading() {
  document.getElementById('reading-result').style.display = 'none';
  currentCard = null;
  renderCardSpread();
}

// ===== YES/NO =====
function doYesNo() {
  const card = TAROT_DECK[Math.floor(Math.random() * TAROT_DECK.length)];
  const isYes = Math.random() > 0.45;
  const ynCard = document.getElementById('yesno-card');
  ynCard.classList.add('animate-cardReveal');
