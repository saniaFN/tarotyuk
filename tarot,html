// ===== DREAM READING =====
function doDreamReading() {
  const text = document.getElementById('dream-input').value.trim();
  if (!text) { showToast('Ceritakan mimpimu dulu...', 'info'); return; }
  const btn = document.getElementById('dream-btn');
  btn.disabled = true; btn.textContent = '🔮 Membaca...';

  // Match dream keywords to cards
  let bestCard = null; let bestScore = 0;
  const lower = text.toLowerCase();
  TAROT_DECK.forEach(card => {
    let score = 0;
    card.keywords.forEach(kw => { if (lower.includes(kw)) score += 2; });
    if (lower.includes(card.name.toLowerCase())) score += 5;
    if (score > bestScore) { bestScore = score; bestCard = card; }
  });
  if (!bestCard) bestCard = TAROT_DECK[Math.floor(Math.random() * TAROT_DECK.length)];

  setTimeout(() => {
    document.getElementById('dream-emoji').textContent = bestCard.emoji;
    document.getElementById('dream-card-name').textContent = bestCard.name;
    document.getElementById('dream-card-meaning').textContent = `Mimpimu terhubung dengan ${bestCard.name}. ${bestCard.meaning} Kristal yang cocok: ${bestCard.crystal} 💎`;
    document.getElementById('dream-result').style.display = 'block';
    btn.disabled = false; btn.textContent = '🔮 Baca Mimpi';
  }, 1200);
}

// ===== LIMINAL SPREAD =====
