  const container = document.getElementById('liminal-cards');
  container.innerHTML = '';
  ['Sekarang', 'Penghambat', 'Tujuan'].forEach((label, i) => {
    const div = document.createElement('div');
    div.className = 'text-center';
    div.innerHTML = `
      <div class="card-back rounded-xl relative mx-auto mb-2" style="width:70px;height:105px">
        <span style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:1.2rem;color:rgba(186,156,255,0.4)">✦</span>
      </div>
      <p class="text-xs" style="color:rgba(186,156,255,0.5)">${label}</p>`;
