function doLiminalReading() {
  const btn = document.getElementById('liminal-btn');
  btn.disabled = true; btn.textContent = '🌀 Membuka...';
  const shuffled = [...TAROT_DECK].sort(() => Math.random() - 0.5);
  const cards = shuffled.slice(0, 3);
  const labels = ['📍 Di Mana Kamu Sekarang', '⛓ Apa yang Menahanmu', '🌅 Ke Mana Kamu Melangkah'];

  setTimeout(() => {
    const container = document.getElementById('liminal-result-cards');
    container.innerHTML = '';
    cards.forEach((card, i) => {
      const div = document.createElement('div');
      div.className = 'rounded-xl p-4 text-center animate-fadeUp';
      div.style.cssText = `background:rgba(42,26,78,0.8);border:1px solid rgba(186,156,255,0.3);animation-delay:${i*0.2}s`;
      div.innerHTML = `
        <p class="text-xs mb-2" style="color:rgba(186,156,255,0.5)">${labels[i]}</p>
        <div style="font-size:2rem" class="mb-2">${card.emoji}</div>
        <h4 style="font-family:'Cormorant Garamond',serif;color:#ba9cff;font-size:1.1rem">${card.name}</h4>
        <p class="text-xs mt-2" style="color:rgba(232,223,245,0.7)">${card.meaning}</p>
        <p class="text-xs mt-2" style="color:rgba(255,156,219,0.5)">💎 ${card.crystal}</p>`;
      container.appendChild(div);
    });
    document.getElementById('liminal-result').style.display = 'block';
    btn.style.display = 'none';
  }, 1000);
}

// ===== NAVIGATION =====
function showPage(id) {
  ['home','reading','yesno','dream','history','liminal'].forEach(p => {
    document.getElementById('page-' + p).style.display = p === id ? '' : 'none';
  });
  if (id === 'history') renderHistory();
  window.scrollTo(0, 0);
  setTimeout(() => lucide.createIcons(), 50);
}

// ===== TOAST =====
function showToast(msg, type='info') {
  const t = document.createElement('div');
  t.className = `toast toast-${type}`;
  t.textContent = msg;
  document.getElementById('toast-container').appendChild(t);
  setTimeout(() => t.remove(), 3000);
}

// ===== DATA SDK =====
async function saveReading() {
  if (!currentCard) return;
  if (allReadings.length >= 999) {
    showToast('Batas penyimpanan tercapai. Hapus beberapa riwayat.', 'error');
    return;
  }
  const btn = document.getElementById('save-reading-btn');
  btn.disabled = true; btn.textContent = '⏳ Menyimpan...';

  const result = await window.dataSdk.create({
    type: currentCategory || 'general',
    category: CATEGORIES.find(c => c.id === (currentCategory || 'general'))?.label || 'Umum',
    card_name: currentCard.name,
    card_meaning: document.getElementById('result-meaning').textContent,
    user_name: document.getElementById('user-name').value.trim() || 'Anonim',
    journal_note: document.getElementById('journal-input').value.trim(),
    crystal: currentCard.crystal,
    created_at: new Date().toISOString(),
  });

  btn.disabled = false; btn.textContent = '✨ Simpan Pembacaan';
  if (result.isOk) {
    showToast('Pembacaan tersimpan! ✨', 'success');
  } else {
    showToast('Gagal menyimpan. Coba lagi.', 'error');
  }
}

function renderHistory() {
  const list = document.getElementById('history-list');
  const empty = document.getElementById('history-empty');

  if (allReadings.length === 0) {
    list.innerHTML = '';
    empty.style.display = '';
    return;
  }
  empty.style.display = 'none';

  const existingEls = new Map([...list.children].map(el => [el.dataset.rid, el]));
  const sorted = [...allReadings].sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
  const fragment = document.createDocumentFragment();

  sorted.forEach(r => {
    const id = r.__backendId;
    let el = existingEls.get(id);
    if (el) {
      updateHistoryItem(el, r);
      existingEls.delete(id);
    } else {
      el = createHistoryItem(r);
    }
    fragment.appendChild(el);
  });

  existingEls.forEach(el => el.remove());
  list.innerHTML = '';
  list.appendChild(fragment);
}

function createHistoryItem(r) {
  const div = document.createElement('div');
  div.dataset.rid = r.__backendId;
  div.className = 'rounded-lg p-4';
  div.style.cssText = 'background:rgba(42,26,78,0.6);border:1px solid rgba(186,156,255,0.15)';
  updateHistoryItem(div, r);
  return div;
}

function updateHistoryItem(el, r) {
  const d = new Date(r.created_at);
  const dateStr = d.toLocaleDateString('id-ID', { day:'numeric', month:'short', year:'numeric' });
  const isDeleting = deletingId === r.__backendId;

  el.innerHTML = `
    <div class="flex items-start justify-between gap-2">
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 mb-1">
          <span class="text-xs px-2 py-0.5 rounded-full" style="background:rgba(186,156,255,0.15);color:rgba(186,156,255,0.7)">${r.category}</span>
          <span class="text-xs" style="color:rgba(186,156,255,0.35)">${dateStr}</span>
        </div>
        <h4 style="font-family:'Cormorant Garamond',serif;color:#ba9cff;font-size:1.05rem">${r.card_name}</h4>
        <p class="text-xs mt-1 truncate" style="color:rgba(232,223,245,0.6)">${r.card_meaning}</p>
        ${r.journal_note ? `<p class="text-xs mt-1 italic" style="color:rgba(255,156,219,0.5)">"${r.journal_note}"</p>` : ''}
        <p class="text-xs mt-1" style="color:rgba(186,156,255,0.3)">💎 ${r.crystal} · oleh ${r.user_name}</p>
      </div>
      <div class="flex-shrink-0">
        ${isDeleting
          ? `<div class="inline-confirm">
              <button onclick="confirmDelete('${r.__backendId}')" class="text-xs px-2 py-1 rounded" style="background:rgba(245,101,101,0.3);color:#f56565">Hapus?</button>
              <button onclick="cancelDelete()" class="text-xs px-2 py-1 rounded" style="background:rgba(186,156,255,0.15);color:rgba(186,156,255,0.6)">Batal</button>
            </div>`
          : `<button onclick="startDelete('${r.__backendId}')" class="p-1 rounded" style="color:rgba(186,156,255,0.3)" title="Hapus">
              <i data-lucide="trash-2" style="width:14px;height:14px"></i>
            </button>`
        }
      </div>
    </div>`;
  setTimeout(() => lucide.createIcons(), 10);
}

function startDelete(id) { deletingId = id; renderHistory(); }
function cancelDelete() { deletingId = null; renderHistory(); }
async function confirmDelete(id) {
  const record = allReadings.find(r => r.__backendId === id);
  if (!record) return;
  const result = await window.dataSdk.delete(record);
  deletingId = null;
  if (result.isOk) { showToast('Riwayat dihapus.', 'info'); }
  else { showToast('Gagal menghapus.', 'error'); }
}

