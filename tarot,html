];

const CATEGORY_MEANINGS = {
  love: (c) => `Dalam urusan cinta, ${c.name} berbisik: ${c.meaning} Biarkan hatimu terbuka untuk menerima dan memberi kasih sayang.`,
  finance: (c) => `Untuk keuanganmu, ${c.name} menunjukkan: ${c.meaning} Percaya pada langkahmu dan kelola energi finansialmu.`,
  career: (c) => `Di jalur kariermu, ${c.name} menyarankan: ${c.meaning} Langkah berani akan membawa perubahan positif.`,
