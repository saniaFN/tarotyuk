const CATEGORIES = [
  { id:"love", label:"💕 Percintaan", icon:"💕", desc:"Baca energi cintamu" },
  { id:"finance", label:"💰 Keuangan", icon:"💰", desc:"Lihat aliran rezekirmu" },
  { id:"career", label:"💼 Karier", icon:"💼", desc:"Langkah selanjutnya" },
  { id:"selfcare", label:"🧘 Self-Care", icon:"🧘", desc:"Energi dalam dirimu" },
  { id:"yesno", label:"❓ Ya/Tidak", icon:"❓", desc:"Jawaban cepat" },
